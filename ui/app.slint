import { Theme } from "theme.slint";
import { StyledButton, FilterChip, SearchBar, Toast } from "components.slint";
import { DetailsModal, DuplicateModal, ImportModal, DeleteModal } from "modals.slint";
import { ListView } from "std-widgets.slint";

export struct ConversationRow {
    id: string,
    short_id: string,
    title: string,
    project: string,
    local_path: string,
    steps: int,
    relative_time: string,
    full_date: string,
    status_text: string,
    is_copy: bool,
    is_imported: bool,
}

export struct TreeItem {
    id: string,
    short_id: string,
    title: string,
    project_id: string,
    project_name: string,
    local_path: string,
    steps: int,
    relative_time: string,
    compact_time: string,
    full_date: string,
    status_text: string,
    is_copy: bool,
    is_imported: bool,
    is_active: bool,
    is_project: bool,
    is_expanded: bool,
    is_empty_placeholder: bool,
    item_count: int,
}

export component AppWindow inherits Window {
    title: "agychat — Antigravity Chat Manager";
    icon: @image-url("../agychat.svg");
    min-width: 820px;
    min-height: 520px;
    preferred-width: 1040px;
    preferred-height: 680px;
    background: Theme.bg-window;

    // Modo de vista actual: "tree" (por defecto estilo Antigravity) o "table"
    in-out property <string> view_mode: "tree";

    // Propiedades de la lista y selección (Tabla)
    in-out property <[ConversationRow]> conversations: [];
    in-out property <int> selected_index: -1;

    // Propiedades del Árbol Jerárquico
    in-out property <[TreeItem]> tree_items: [];
    in-out property <int> selected_tree_index: -1;

    // Selección compartida
    in-out property <string> selected_id: "";
    in-out property <string> selected_title: "";
    in-out property <string> search_text: "";
    in-out property <string> active_filter: "all";

    // Contadores para los chips de filtro
    in-out property <int> total_count: 0;
    in-out property <int> workspace_count: 0;
    in-out property <int> copies_count: 0;
    in-out property <int> recent_count: 0;

    // Estado de Language Server y resumen de disco
    in-out property <bool> ls_connected: false;
    in-out property <string> ls_status_text: "Conectando...";
    in-out property <string> disk_summary_text: "";

    // Toast
    in-out property <bool> toast_visible: false;
    in-out property <string> toast_message: "";

    // Modales
    in-out property <bool> show_details: false;
    in-out property <string> det_project: "";
    in-out property <string> det_path: "";
    in-out property <int> det_steps: 0;
    in-out property <string> det_date: "";
    in-out property <string> det_db_size: "0 B";
    in-out property <string> det_brain_size: "0 B";
    in-out property <int> det_brain_files: 0;
    in-out property <string> det_total_size: "0 B";

    in-out property <bool> show_duplicate: false;
    in-out property <string> dup_new_title: "";

    in-out property <bool> show_import: false;
    in-out property <string> imp_archive_path: "";
    in-out property <string> imp_custom_title: "";
    in-out property <string> imp_target_workspace: "";
    in-out property <bool> imp_new_id: true;
    in-out property <bool> imp_overwrite: false;

    in-out property <bool> show_delete: false;

    // Menú contextual flotante
    in-out property <bool> show_context_menu: false;
    in-out property <length> menu_x: 0px;
    in-out property <length> menu_y: 0px;

    // Callbacks a Rust
    callback refresh();
    callback search_edited(string);
    callback filter_selected(string);
    callback sort_column(int);
    callback row_selected(int, string);
    callback row_double_clicked(int, string);
    callback row_right_clicked(int, string, length, length);

    // Callbacks de Vista en Árbol
    callback view_mode_changed(string);
    callback toggle_project_expanded(string);
    callback tree_row_selected(int, string);
    callback tree_row_double_clicked(int, string);
    callback tree_row_right_clicked(int, string, length, length);

    callback action_details();
    callback action_duplicate();
    callback action_export();
    callback action_delete();

    callback copy_uuid();
    callback copy_ficha();
    callback open_workspace_folder();

    callback confirm_duplicate(string);
    callback confirm_import(string, string, string, bool, bool);
    callback confirm_delete(string);

    callback import_browse_archive();
    callback import_browse_workspace();

    // Manejador global de la tecla Escape para cerrar modales y menú contextual
    forward-focus: key_handler;
    key_handler := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.show_context_menu = false;
                root.show_details = false;
                root.show_duplicate = false;
                root.show_import = false;
                root.show_delete = false;
                accept
            } else {
                reject
            }
        }
    }

    // Layout Principal de la Ventana
    VerticalLayout {
        spacing: 0;

        // 1. Barra de Herramientas Superior (con margen superior)
        Rectangle {
            background: Theme.bg-window;
            height: 60px;

            HorizontalLayout {
                padding-top: 14px;
                padding-bottom: 12px;
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;

                SearchBar {
                    text <=> root.search_text;
                    placeholder: "Buscar por título, proyecto o UUID...";
                    horizontal-stretch: 1;
                    edited(txt) => { root.search_edited(txt); }
                    clear() => { root.search_edited(""); }
                }

                StyledButton {
                    text: "Refrescar";
                    icon: "🔄";
                    clicked => { root.refresh(); }
                }

                StyledButton {
                    text: "Importar Chat";
                    icon: "📦";
                    variant: "primary";
                    clicked => {
                        root.show_details = false;
                        root.show_duplicate = false;
                        root.show_delete = false;
                        root.show_context_menu = false;
                        root.imp_archive_path = "";
                        root.imp_custom_title = "";
                        root.imp_target_workspace = "";
                        root.imp_new_id = true;
                        root.imp_overwrite = false;
                        root.show_import = true;
                    }
                }
            }
        }

        // Línea divisoria
        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // 2. Barra de Filtros Rápidos (Chips)
        Rectangle {
            background: Theme.bg-window;
            height: 38px;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 8px;

                Text {
                    text: "Filtros:";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                FilterChip {
                    text: "Todos (" + root.total_count + ")";
                    active: root.active_filter == "all";
                    clicked => { root.filter_selected("all"); }
                }

                FilterChip {
                    text: "Con Workspace (" + root.workspace_count + ")";
                    active: root.active_filter == "workspace";
                    clicked => { root.filter_selected("workspace"); }
                }

                FilterChip {
                    text: "Copias / Ramas (" + root.copies_count + ")";
                    active: root.active_filter == "copies";
                    clicked => { root.filter_selected("copies"); }
                }

                FilterChip {
                    text: "Recientes (" + root.recent_count + ")";
                    active: root.active_filter == "recent";
                    clicked => { root.filter_selected("recent"); }
                }

                Rectangle { horizontal-stretch: 1; }

                // Selector de Vista: Árbol vs Tabla
                Rectangle {
                    background: #111622;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    border-radius: Theme.radius-sm;
                    height: 28px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        Rectangle {
                            border-radius: 4px;
                            background: root.view_mode == "tree" ? Theme.accent-blue : (tree_btn_touch.has-hover ? #ffffff10 : #00000000);
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "🌲 Árbol";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.view_mode == "tree" ? #ffffff : Theme.text-subtle;
                                    vertical-alignment: center;
                                }
                            }
                            tree_btn_touch := TouchArea {
                                clicked => { root.view_mode_changed("tree"); }
                            }
                        }

                        Rectangle {
                            border-radius: 4px;
                            background: root.view_mode == "table" ? Theme.accent-blue : (tbl_btn_touch.has-hover ? #ffffff10 : #00000000);
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "📋 Tabla";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.view_mode == "table" ? #ffffff : Theme.text-subtle;
                                    vertical-alignment: center;
                                }
                            }
                            tbl_btn_touch := TouchArea {
                                clicked => { root.view_mode_changed("table"); }
                            }
                        }
                    }
                }
            }
        }

        // Línea divisoria
        Rectangle {
            height: 1px;
            background: #ffffff0a;
        }

        // 3. Encabezados de la Tabla (solo visibles en modo tabla)
        if root.view_mode == "table": Rectangle {
            background: Theme.bg-header;
            height: 36px;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;

                // Columna 1: Conversación
                TouchArea {
                    horizontal-stretch: 1;
                    clicked => { root.sort_column(0); }
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "Conversación ▲";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Columna 2: Proyecto / Workspace
                TouchArea {
                    width: 210px;
                    clicked => { root.sort_column(1); }
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "Proyecto / Workspace";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Columna 3: Pasos
                TouchArea {
                    width: 85px;
                    clicked => { root.sort_column(2); }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Pasos";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Columna 4: Última Actividad
                TouchArea {
                    width: 125px;
                    clicked => { root.sort_column(3); }
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "Última Actividad";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Columna 5: UUID
                Rectangle {
                    width: 85px;
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "UUID";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Línea divisoria de tabla
        if root.view_mode == "table": Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // 4a. Vista en Árbol Jerárquico por Proyecto (Estilo Antigravity)
        if root.view_mode == "tree": tree_list := ListView {
            vertical-stretch: 1;

            for item[idx] in root.tree_items: Rectangle {
                height: item.is_project ? 34px : 38px;
                background: (!item.is_project && !item.is_empty_placeholder && root.selected_id == item.id)
                    ? #2563eb30
                    : (row_touch.has-hover ? Theme.bg-surface-hover : #00000000);

                // Línea separadora sutil
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: item.is_project ? #ffffff0d : #ffffff04;
                }

                // Indicador de selección lateral para chats
                if !item.is_project && !item.is_empty_placeholder && root.selected_id == item.id: Rectangle {
                    x: 0px;
                    width: 3px;
                    height: parent.height;
                    background: Theme.accent-blue;
                }

                // CASO 1: Cabecera de Proyecto / Carpeta
                if item.is_project: HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 18px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: item.is_expanded ? "▾" : "▸";
                        font-size: 11px;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }

                    Text {
                        text: item.is_expanded ? "📂" : "📁";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: item.project_name;
                        font-size: 13px;
                        font-weight: 600;
                        color: #cbd5e1;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if item.item_count > 0: Rectangle {
                        background: #ffffff12;
                        border-radius: 999px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: item.item_count;
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.text-subtle;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // CASO 2: Placeholder cuando un proyecto está vacío
                if item.is_empty_placeholder: HorizontalLayout {
                    padding-left: 42px;
                    padding-right: 18px;
                    alignment: start;

                    Text {
                        text: "No conversations yet";
                        font-size: 12px;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }

                // CASO 3: Fila de Conversación / Chat
                if !item.is_project && !item.is_empty_placeholder: HorizontalLayout {
                    padding-left: 36px;
                    padding-right: 18px;
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: item.title;
                        font-size: 13px;
                        font-weight: root.selected_id == item.id ? 600 : 400;
                        color: root.selected_id == item.id ? #ffffff : #e2e8f0;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if item.is_copy: Rectangle {
                        background: #a855f725;
                        border-width: 1px;
                        border-color: #a855f750;
                        border-radius: 4px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "Copia";
                                font-size: 9px;
                                font-weight: 700;
                                color: #c084fc;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if item.is_imported: Rectangle {
                        background: #10b98125;
                        border-width: 1px;
                        border-color: #10b98150;
                        border-radius: 4px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "Importado";
                                font-size: 9px;
                                font-weight: 700;
                                color: #34d399;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if item.is_active: Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #38bdf8;
                        y: (parent.height - self.height) / 2;
                    }

                    if item.compact_time != "": Text {
                        text: item.compact_time;
                        font-size: 11px;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }

                row_touch := TouchArea {
                    clicked => {
                        if item.is_project {
                            root.toggle_project_expanded(item.project_id);
                        } else if !item.is_empty_placeholder {
                            root.tree_row_selected(idx, item.id);
                        }
                    }
                    double_clicked => {
                        if !item.is_project && !item.is_empty_placeholder {
                            root.tree_row_double_clicked(idx, item.id);
                        }
                    }
                    pointer_event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                            if !item.is_project && !item.is_empty_placeholder {
                                root.tree_row_right_clicked(idx, item.id, self.mouse-x, 100px + idx * 38px + tree_list.content-y + self.mouse-y);
                            }
                        }
                    }
                }
            }
        }

        // 4b. Lista Virtualizada de Conversaciones (Modo Tabla)
        if root.view_mode == "table": table_list := ListView {
            vertical-stretch: 1;

            for item[idx] in root.conversations: Rectangle {
                height: 42px;
                background: root.selected_index == idx ? #2563eb30 : (item_touch.has-hover ? Theme.bg-surface-hover : #00000000);

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #ffffff08;
                }

                if root.selected_index == idx: Rectangle {
                    x: 0px;
                    width: 3px;
                    height: parent.height;
                    background: Theme.accent-blue;
                }

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;

                    // Columna 1: Conversación con emoji 💬
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "💬 " + item.title;
                            font-size: 13px;
                            font-weight: 600;
                            color: root.selected_index == idx ? #ffffff : #f1f5f9;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        if item.is_copy: Rectangle {
                            background: #a855f725;
                            border-width: 1px;
                            border-color: #a855f750;
                            border-radius: 4px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "Copia";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: #c084fc;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if item.is_imported: Rectangle {
                            background: #10b98125;
                            border-width: 1px;
                            border-color: #10b98150;
                            border-radius: 4px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "Importado";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: #34d399;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Columna 2: Proyecto / Workspace con emoji 📁
                    Rectangle {
                        width: 210px;
                        clip: true;
                        HorizontalLayout {
                            alignment: start;

                            Text {
                                text: item.project == "(Sin workspace)" ? "(Sin workspace)" : ("📁 " + item.project);
                                font-size: 12px;
                                color: item.project == "(Sin workspace)" ? Theme.text-subtle : Theme.text-muted;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Columna 3: Pasos
                    Rectangle {
                        width: 85px;
                        HorizontalLayout {
                            alignment: center;

                            Rectangle {
                                background: #3b82f61f;
                                border-radius: 999px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;

                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    Text {
                                        text: item.steps + " pasos";
                                        font-size: 11px;
                                        font-weight: 600;
                                        font-family: "monospace";
                                        color: #60a5fa;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Columna 4: Modificación
                    Rectangle {
                        width: 125px;
                        clip: true;
                        HorizontalLayout {
                            alignment: start;
                            Text {
                                text: item.relative_time;
                                font-size: 12px;
                                color: Theme.text-subtle;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Columna 5: UUID
                    Rectangle {
                        width: 85px;
                        clip: true;
                        HorizontalLayout {
                            alignment: start;
                            Text {
                                text: item.short_id;
                                font-size: 11px;
                                font-family: "monospace";
                                color: Theme.text-dim;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                item_touch := TouchArea {
                    clicked => {
                        root.row_selected(idx, item.id);
                    }
                    double_clicked => {
                        root.row_double_clicked(idx, item.id);
                    }
                    pointer_event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                            root.row_right_clicked(idx, item.id, self.mouse-x, 137px + idx * 42px + table_list.content-y + self.mouse-y);
                        }
                    }
                }
            }
        }

        // Estado vacío si no hay resultados
        if (root.view_mode == "tree" && root.tree_items.length == 0) || (root.view_mode == "table" && root.conversations.length == 0): Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "🔍";
                    font-size: 36px;
                    color: Theme.text-subtle;
                    horizontal-alignment: center;
                }
                Text {
                    text: "No se encontraron conversaciones";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text-main;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Prueba con otro término de búsqueda o cambia el filtro activo.";
                    font-size: 12px;
                    color: Theme.text-subtle;
                    horizontal-alignment: center;
                }
            }
        }

        // Línea divisoria
        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // 5. Barra Inferior de Acciones con emojis
        Rectangle {
            background: Theme.bg-header;
            height: 48px;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 10px;

                Text {
                    text: root.selected_index >= 0 ? ("Seleccionado: \"" + root.selected_title + "\" (" + root.selected_id + ")") : "Selecciona una conversación para duplicar, ver detalles, exportar o eliminar.";
                    font-size: 12px;
                    color: root.selected_index >= 0 ? Theme.text-main : Theme.text-subtle;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                StyledButton {
                    text: "Detalles";
                    icon: "🗂️";
                    enabled: root.selected_index >= 0;
                    clicked => { root.action_details(); }
                }

                StyledButton {
                    text: "Duplicar";
                    icon: "📋";
                    enabled: root.selected_index >= 0;
                    clicked => { root.action_duplicate(); }
                }

                StyledButton {
                    text: "Exportar";
                    icon: "📦";
                    enabled: root.selected_index >= 0;
                    clicked => { root.action_export(); }
                }

                StyledButton {
                    text: "Eliminar";
                    icon: "🗑️";
                    variant: "danger";
                    enabled: root.selected_index >= 0;
                    clicked => { root.action_delete(); }
                }
            }
        }

        // Línea divisoria
        Rectangle {
            height: 1px;
            background: #ffffff0a;
        }

        // 6. Barra de Estado del Sistema (alineada con punto indicador verde/ámbar)
        Rectangle {
            background: #090c12;
            height: 30px;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 8px;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    y: (parent.height - self.height) / 2;
                    background: root.ls_connected ? Theme.accent-emerald : Theme.accent-amber;
                }

                Text {
                    text: root.ls_status_text;
                    font-size: 11px;
                    font-weight: 500;
                    color: root.ls_connected ? Theme.accent-emerald : Theme.accent-amber;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.disk_summary_text;
                    font-size: 11px;
                    font-family: "monospace";
                    color: Theme.text-subtle;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Menú contextual flotante (Click derecho con emojis)
    if root.show_context_menu: Rectangle {
        width: 100%;
        height: 100%;
        x: 0px;
        y: 0px;

        // Backdrop transparente: al hacer clic en cualquier parte exterior, se cierra el menú
        TouchArea {
            clicked => {
                root.show_context_menu = false;
            }
            pointer_event(event) => {
                if event.kind == PointerEventKind.up {
                    root.show_context_menu = false;
                }
            }
        }

        Rectangle {
            x: root.menu_x;
            y: root.menu_y;
            width: 230px;
            background: #171d28;
            border-width: 1px;
            border-color: #ffffff20;
            border-radius: Theme.radius-md;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000aa;

            TouchArea {
                // Absorber clics dentro del menú
            }

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: ctx1.has-hover ? Theme.accent-blue : #00000000;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "🗂️ Ver detalles";
                        font-size: 12px;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
                ctx1 := TouchArea {
                    clicked => {
                        root.show_context_menu = false;
                        root.action_details();
                    }
                }
            }

            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: ctx2.has-hover ? Theme.accent-blue : #00000000;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "📋 Duplicar conversación";
                        font-size: 12px;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
                ctx2 := TouchArea {
                    clicked => {
                        root.show_context_menu = false;
                        root.action_duplicate();
                    }
                }
            }

            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: ctx3.has-hover ? Theme.accent-blue : #00000000;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "📦 Exportar a .agychat";
                        font-size: 12px;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
                ctx3 := TouchArea {
                    clicked => {
                        root.show_context_menu = false;
                        root.action_export();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #ffffff15;
            }

            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: ctx4.has-hover ? Theme.accent-blue : #00000000;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "📋 Copiar UUID";
                        font-size: 12px;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
                ctx4 := TouchArea {
                    clicked => {
                        root.show_context_menu = false;
                        root.copy_uuid();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #ffffff15;
            }

            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: ctx5.has-hover ? #dc2626 : #00000000;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "🗑️ Eliminar conversación";
                        font-size: 12px;
                        color: #f87171;
                        vertical-alignment: center;
                    }
                }
                ctx5 := TouchArea {
                    clicked => {
                        root.show_context_menu = false;
                        root.action_delete();
                    }
                }
            }
        }
    }
}

    // Modal 1: Detalles
    DetailsModal {
        show <=> root.show_details;
        title: root.selected_title;
        uuid: root.selected_id;
        project: root.det_project;
        path: root.det_path;
        steps: root.det_steps;
        date: root.det_date;
        db-size: root.det_db_size;
        brain-size: root.det_brain_size;
        brain-files: root.det_brain_files;
        total-size: root.det_total_size;

        close => { root.show_details = false; }
        open-folder => { root.open_workspace_folder(); }
        copy-uuid => { root.copy_uuid(); }
        copy-ficha => { root.copy_ficha(); }
    }

    // Modal 2: Duplicar
    DuplicateModal {
        show <=> root.show_duplicate;
        original-title: root.selected_title;
        new-title <=> root.dup_new_title;

        close => { root.show_duplicate = false; }
        confirm => {
            root.show_duplicate = false;
            root.confirm_duplicate(root.dup_new_title);
        }
    }

    // Modal 3: Importar
    ImportModal {
        show <=> root.show_import;
        archive-path <=> root.imp_archive_path;
        custom-title <=> root.imp_custom_title;
        target-workspace <=> root.imp_target_workspace;
        new-id <=> root.imp_new_id;
        overwrite <=> root.imp_overwrite;

        close => { root.show_import = false; }
        browse-archive => { root.import_browse_archive(); }
        browse-workspace => { root.import_browse_workspace(); }
        confirm => {
            root.show_import = false;
            root.confirm_import(
                root.imp_archive_path,
                root.imp_custom_title,
                root.imp_target_workspace,
                root.imp_new_id,
                root.imp_overwrite
            );
        }
    }

    // Modal 4: Eliminar
    DeleteModal {
        show <=> root.show_delete;
        title: root.selected_title;
        uuid: root.selected_id;

        close => { root.show_delete = false; }
        confirm => {
            root.show_delete = false;
            root.confirm_delete(root.selected_id);
        }
    }

    // Notificación Toast
    Rectangle {
        x: parent.width - 340px;
        y: parent.height - 76px;
        width: 310px;
        Toast {
            message: root.toast_message;
            is_visible: root.toast_visible;
        }
    }
}

import { Theme } from "theme.slint";

export component StyledButton {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> enabled: true;
    in property <string> variant: "default"; // "default", "primary", "success", "danger"
    callback clicked();

    vertical-stretch: 0;
    horizontal-stretch: 0;

    VerticalLayout {
        alignment: center;

        rect := Rectangle {
            height: 30px;
            background: !root.enabled ? #16181d :
                        touch.pressed ? (root.variant == "primary" ? #1d4ed8 : (root.variant == "danger" ? #991b1b : (root.variant == "success" ? #047857 : Theme.bg-surface-active))) :
                        touch.has-hover ? (root.variant == "primary" ? #3b82f6 : (root.variant == "danger" ? #b91c1c : (root.variant == "success" ? #10b981 : Theme.bg-surface-hover))) :
                        (root.variant == "primary" ? #2563eb : (root.variant == "danger" ? #ef444422 : (root.variant == "success" ? #059669 : Theme.bg-surface)));
            border-width: 1px;
            border-color: !root.enabled ? Theme.border-subtle :
                          (root.variant == "primary" ? #60a5fa : (root.variant == "danger" ? #ef444455 : (root.variant == "success" ? #34d399 : Theme.border-subtle)));
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                padding-left: 12px;
                padding-right: 12px;

                if root.icon != "": Text {
                    text: root.icon;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.text;
                    font-size: 12px;
                    font-weight: root.variant == "primary" || root.variant == "success" ? 600 : 500;
                    color: !root.enabled ? Theme.text-subtle : (root.variant == "danger" ? #f87171 : Theme.text-main);
                    vertical-alignment: center;
                }
            }

            touch := TouchArea {
                enabled: root.enabled;
                clicked => { root.clicked(); }
            }
        }
    }
}

export component FilterChip {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    vertical-stretch: 0;
    horizontal-stretch: 0;

    VerticalLayout {
        alignment: center;

        Rectangle {
            height: 24px;
            background: root.active ? #2563eb28 : (touch.has-hover ? #1f2738 : #00000000);
            border-width: 1px;
            border-color: root.active ? Theme.accent-blue : (touch.has-hover ? Theme.text-subtle : Theme.border-subtle);
            border-radius: 999px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: center;

                Text {
                    text: root.text;
                    font-size: 11px;
                    font-weight: root.active ? 600 : 500;
                    color: root.active ? #60a5fa : (touch.has-hover ? Theme.text-main : Theme.text-muted);
                    vertical-alignment: center;
                }
            }

            touch := TouchArea {
                clicked => { root.clicked(); }
            }
        }
    }
}

export component SearchBar {
    in-out property <string> text;
    in property <string> placeholder: "Buscar por título, proyecto o UUID...";
    callback edited(string);
    callback clear();

    vertical-stretch: 0;
    horizontal-stretch: 1;

    VerticalLayout {
        alignment: center;

        Rectangle {
            height: 34px;
            background: Theme.bg-input;
            border-width: 1px;
            border-color: input.has-focus ? Theme.border-focus : Theme.border-subtle;
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                Text {
                    text: "🔍";
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    if root.text == "": Text {
                        width: 100%;
                        height: 100%;
                        text: root.placeholder;
                        font-size: 12px;
                        color: Theme.text-subtle;
                        vertical-alignment: center;
                    }

                    input := TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.text;
                        font-size: 12px;
                        color: Theme.text-main;
                        vertical-alignment: center;
                        edited => { root.edited(self.text); }
                    }
                }

                if root.text == "": Rectangle {
                    background: #ffffff0d;
                    border-width: 1px;
                    border-color: #ffffff14;
                    border-radius: 4px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: "Ctrl+F";
                            font-size: 10px;
                            font-family: "monospace";
                            color: #64748b;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.text != "": Rectangle {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: touch-clear.has-hover ? #334155 : #1e293b;

                    Text {
                        text: "✕";
                        font-size: 9px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    touch-clear := TouchArea {
                        clicked => {
                            root.text = "";
                            root.edited("");
                            root.clear();
                        }
                    }
                }
            }
        }
    }
}

export component Toast {
    in property <string> message: "";
    in property <bool> is_visible: false;

    if root.is_visible: Rectangle {
        background: #1e2638;
        border-width: 1px;
        border-color: #ffffff25;
        border-radius: Theme.radius-md;
        height: 42px;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            alignment: center;

            Text {
                text: "✨";
                font-size: 13px;
                vertical-alignment: center;
            }

            Text {
                text: root.message;
                font-size: 13px;
                font-weight: 500;
                color: #ffffff;
                vertical-alignment: center;
            }
        }
    }
}
